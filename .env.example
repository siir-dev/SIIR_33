# Frontend build settings
# Public URL of the site. Share-card meta tags (og:image, twitter:image) need an absolute URL.
VITE_SITE_URL=https://siir.example
# Base URL of the API (leave empty in dev: Vite proxies /api to localhost:3001)
# VITE_API_URL=https://api.siir.example/api/v1

# Vercel function api/seen.ts (share cards for crawlers on /seen/:handle). Set in the Vercel project, not here:
# API_URL=https://api.siir.example/api/v1
# SITE_URL=https://siir.example
