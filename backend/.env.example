# =============================================================================
# SIIR backend environment. Copy to .env (git-ignored) and fill in.
# =============================================================================

# --- Supabase Postgres (REQUIRED) ----------------------------------------------
# Supabase dashboard > Connect, or Project Settings > Database > Connection string > URI.

# Transaction pooler (port 6543). Used by the running API.
# connection_limit=10 suits a long-running server. Use connection_limit=1 only for serverless functions,
# where a single connection makes parallel queries wait on each other.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# Direct connection (port 5432), or the Session pooler if your network is IPv4-only.
# Used by "prisma migrate deploy" and the seed.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# URL-encode special characters in the password (@ becomes %40, # becomes %23).

# --- API -----------------------------------------------------------------------
PORT=3001

# --- Editorial gate (REQUIRED to use /editorial). Send as the x-editorial-key header. ---
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITORIAL_API_KEY=""

# --- Queue (optional). Without it the scan pipeline runs inside the API process. ---
# REDIS_URL="redis://localhost:6379"

# --- Methodology thresholds (defaults shown; proposals until signed off) -----------
# SIIR_CONSISTENCY_THRESHOLD=60        # minimum listed score for an epoch to count toward Consistency
# SIIR_BRIDGED_ONCHAIN_THRESHOLD=0.4   # on-chain component needed on EACH chain for the Bridged badge

# --- Ingestion sources (optional; a missing key means that signal is simply absent) ---
# X_BEARER_TOKEN=""
# HELIUS_API_KEY=""
# SOLANA_RPC_URL=""
# ROBINHOOD_RPC_URL=""
# ROBINHOOD_EXPLORER_URL=""

# --- AI drafting of "Why they're Seen" (optional, OpenAI-compatible) ----------------
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# --- Local development only. NEVER enable in production. -------------------------
# ALLOW_MOCK_SIGNATURES=true
